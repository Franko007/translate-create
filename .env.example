# --- Credenciales: elegir UNA de las dos -------------
# (a) Gemini API con API key (por defecto) ------------
GEMINI_API_KEY=
# (b) Vertex AI ----------------------------------------
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# --- Salida del producto generado (Nivel 2) ----------
OUT_DIR=generated/nerdearla-subtitles

# --- Control de la corrida ---------------------------
MAX_FIX_ITERATIONS=3      # tope de bucles de correccion
MAX_TOKENS_BUDGET=200000  # tope estimado de tokens de la corrida
APPROVAL_MODE=yes         # yes | no | ask (puertas humanas para comandos)
RUN_TIMEOUT_S=120         # timeout de cada comando ejecutado por qa

# --- Modelos por agente (verificados 2026-09) --------
PLANNER_MODEL=gemini-3.1-flash-lite
ARCHITECT_MODEL=gemini-3.1-flash-lite
BACKEND_MODEL=gemini-3.5-flash
FRONTEND_MODEL=gemini-3.5-flash
QA_MODEL=gemini-3.1-flash-lite
DOCS_MODEL=gemini-3.1-flash-lite
REVIEWER_MODEL=gemini-3.1-flash-lite

# --- Modo Full Team: backend/frontend via A2A ---------
# Levanta cada servicio con su local_server y setea:
# BACKEND_AGENT_RESOURCE_NAME=local:8095
# FRONTEND_AGENT_RESOURCE_NAME=local:8096
# Si no se setean, build_project.py usa AgentTool local (camino minimo).

# --- Puertos de los servicios A2A --------------------
PLANNER_PORT=8084
BACKEND_PORT=8095
FRONTEND_PORT=8096